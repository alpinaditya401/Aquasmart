# Contoh konfigurasi environment — SALIN ke .env lalu isi nilai asli.
# File ini hanya placeholder. JANGAN menulis nilai asli di sini.
# .env (asli) sudah diabaikan .gitignore dan tidak boleh di-commit.

# Kunci session Flask — WAJIB diganti di production (min. 32 karakter acak).
SECRET_KEY=ganti-dengan-string-acak-min-32-karakter

# Database. Default: SQLite lokal (instance/aquasmart.sqlite).
# Untuk Postgres (mis. Railway plugin): postgresql://user:pass@host:5432/db
DATABASE_URL=

# Password Postgres untuk docker-compose.yml (service db). Isi string acak.
POSTGRES_PASSWORD=ganti-dengan-password-acak

# URL Redis untuk rate limit storage (opsional).
# Jika kosong → fallback in-memory + warning di log.
REDIS_URL=

# Scheduler expiry command hanya jalan bila "true" (mencegah dobel multi-worker).
SCHEDULER_ENABLED=false

# Menit hingga command pending dianggap kedaluwarsa.
COMMAND_EXPIRY_MINUTES=10

# Origin yang diizinkan CORS untuk /api/*, pisahkan koma.
# Contoh production: https://aquasmart.vercel.app
CORS_ORIGINS=http://localhost:3000
